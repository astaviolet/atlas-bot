# Copie para .env e preencha. Nunca commitar o .env (esta no .gitignore).
# Nenhum valor aqui e exemplo real: tudo comecar vazio.

# --- Discord -------------------------------------------------------------
# Token do bot, em discord.com/developers/applications -> sua aplicacao -> Bot
DISCORD_TOKEN=

# ID do canal de controle (canal privado onde o agente aceita pedidos).
# Se ficar vazio, o bot procura um canal chamado "atlas-config" ou com
# "[atlas-control]" no topico.
ATLAS_CONTROL_CHANNEL_ID=

# --- Camada de IA --------------------------------------------------------
# O bot fala com qualquer endpoint compativel com a API OpenAI
# (formato POST /chat/completions). Trocar de provedor e trocar estas tres
# linhas; nao ha provedor hardcoded no codigo.
#
# Nao existe chave de exemplo aqui, nem valor ficticio, nem default embutido.
# AI_API_KEY=
AI_API_KEY=
# AI_BASE_URL=  endereco do gateway, sem barra no final
AI_BASE_URL=
# AI_MODEL=     nome do modelo exatamente como o gateway espera
AI_MODEL=

# --- Opcional ------------------------------------------------------------
# Caminho do log de auditoria (JSONL). Default: logs/audit.jsonl
ATLAS_AUDIT_PATH=logs/audit.jsonl
